# Morse decoder tap-timing thresholds (milliseconds).
# Copy to `.env` and tune: cp .env.example .env  ->  restart `npm run dev`.
# Vite only exposes variables prefixed with VITE_ to client code.

# Dwell thresholds for a single space-bar press.
VITE_MORSE_TAP_MIN_MS=40
VITE_MORSE_TAP_MAX_MS=200
VITE_MORSE_HOLD_MIN_MS=250
VITE_MORSE_HOLD_MAX_MS=700

# Silence thresholds between two presses — three tiers, each longer than the last:
# a character boundary, a word space, then a line break.
VITE_MORSE_LETTER_GAP_MS=250
VITE_MORSE_WORD_GAP_MS=900
VITE_MORSE_LINE_GAP_MS=1800
